# Copiar a .env y completar. .env no se versiona.
# Token de https://dashboard.ngrok.com/get-started/your-authtoken (solo para el servicio ngrok de compose)
NGROK_AUTHTOKEN=
# Si se definen, toda la app exige HTTP Basic Auth (recomendado al exponerla con ngrok)
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=
