<!DOCTYPE html>
<html lang="es">
  <head>
    <title><%= content_for(:title) || "Gestor de vacaciones" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Nunito+Sans:opsz,wght@6..12,400;6..12,600;6..12,700;6..12,800&display=swap" rel="stylesheet">
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <header class="topbar">
      <div class="brand">
        <span class="brand-mark">v</span>
        <span class="brand-name">Gestor de vacaciones</span>
        <span class="brand-tag">POC</span>
      </div>
      <%= form_with url: session_path, method: :patch, class: "actor-switch", data: { turbo: false } do %>
        <label for="actor_id">Ver como</label>
        <select name="actor_id" id="actor_id" onchange="this.form.submit()">
          <% { "hr" => "RRHH", "manager" => "Jefatura", "employee" => "Colaborador" }.each do |role, label| %>
            <optgroup label="<%= label %>">
              <% current_actor.company.employees.where(role: role).ordered.each do |e| %>
                <option value="<%= e.id %>" <%= "selected" if e == current_actor %>><%= e.name %></option>
              <% end %>
            </optgroup>
          <% end %>
        </select>
        <span class="avatar avatar-sm"><%= current_actor.initials %></span>
      <% end %>
    </header>

    <div class="shell">
      <nav class="sidebar">
        <% if current_actor.hr? %>
          <div class="nav-section">RRHH</div>
          <%= nav_link "Colaboradores", employees_path, icon: "👥", active: controller_name.in?(%w[employees leave_periods adjustments]) %>
        <% end %>
        <% if current_actor.hr? || current_actor.manager? %>
          <div class="nav-section">Jefatura</div>
          <%= nav_link "Historial del equipo", team_path, icon: "📅" %>
        <% end %>
        <div class="nav-section">Personal</div>
        <%= nav_link "Mi saldo", my_balance_path, icon: "🌴" %>
      </nav>

      <main class="content">
        <% if notice %><div class="flash flash-notice"><%= notice %></div><% end %>
        <% if alert %><div class="flash flash-alert"><%= alert %></div><% end %>
        <%= yield %>
      </main>
    </div>
  </body>
</html>
